# Copy to .env.local and fill in your MongoDB Atlas connection string
# Example: mongodb+srv://user:password@cluster.mongodb.net/?appName=...
MONGODB_URI=
MONGODB_DB=shofi_traders

# Sonali SMS (sonalisms.com) — used to notify borrowers on loan/payment.
# Use the gateway IP directly: the api.sonalisms.com hostname accepts requests
# but does not deliver them.
SMS_API_URL=http://103.177.125.106:7788/sendtext
SMS_API_KEY=
SMS_SECRET_KEY=
# Sender ID: either an approved mask ("Shofi Trade") or a phone number.
SMS_CALLER_ID=
